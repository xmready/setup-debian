[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*.un~
Session.vim
Sessionx.vim
.netrw*

# emacs: autosave and lock files
