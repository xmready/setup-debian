#!/usr/bin/bash

# Discussion, issues and change requests at:
#   https://github.com/xmready/setup-debian
#
# Purpose:
#   A script to upgrade apt, rclone, flatpak, nvm, Homebrew, ghcup, cabal and opencode

set -euo pipefail

red="$(tput setaf 1 2>/dev/null || true)"
green="$(tput setaf 2 2>/dev/null || true)"
yellow="$(tput setaf 3 2>/dev/null || true)"
bold="$(tput bold 2>/dev/null || true)"
reset="$(tput sgr0 2>/dev/null || true)"
bel="$(tput bel 2>/dev/null || true)"
readonly red green yellow bold reset bel

success() { local msg="$*"; printf '%s\n' "${green}${bold}success: ${msg}${reset}"; }
info() { local msg="$*"; printf '%s\n' "${yellow}${bold}info: ${msg}${reset}"; }
err() { local msg="$*"; printf '%s\n' "${red}${bold}error: ${msg}${reset}${bel}" >&2; }
die() { err "$@"; exit 1; }

get_latest_release() {
  curl --fail --silent "https://api.github.com/repos/$1/releases/latest" |
  grep --max-count=1 '"tag_name":' |
  sed -E 's/.*"tag_name": *"([^"]+)".*/\1/'
}

upgrade_node() {
  local node_old

  node_old="$(node --version)" \
    && nvm install --lts \
    && if [[ "$(node --version)" != "$node_old" ]]; then
         nvm reinstall-packages "$node_old" \
           && nvm uninstall "$node_old"
       fi
}

main() {
  [[ "$EUID" -ne 0 ]] || die 'run as your normal sudo user, not root'

  sudo --validate || die 'sudo authentication failed'

  remote_raw_url='https://raw.githubusercontent.com'
  nvm_remote_name='nvm-sh/nvm'
  failed=()

  info 'upgrading apt...' \
    && sudo apt-get update \
    && sudo apt-get upgrade --assume-yes \
    && sudo apt-get full-upgrade --assume-yes \
    && success 'apt upgraded' \
    || failed+=('apt')

  info 'upgrading rclone...' \
    && sudo rclone selfupdate --package deb \
    && success 'rclone upgraded' \
    || failed+=('rclone')

  info 'cleaning apt...' \
    && sudo apt-get autoremove --assume-yes \
    && sudo apt-get autoclean --assume-yes \
    && success 'apt cleaned' \
    || failed+=('apt cleanup')

  info 'upgrading flatpaks...' \
    && flatpak update --user --assumeyes \
    && success 'flatpaks upgraded' \
    || failed+=('flatpak')

  info 'upgrading nvm...' \
    && nvm_version="$(get_latest_release "$nvm_remote_name")" \
    && curl --fail --silent --show-error --location "${remote_raw_url}/${nvm_remote_name}/${nvm_version}/install.sh" | bash - \
    && [[ -s "${NVM_DIR}/nvm.sh" ]] \
    && \. "$NVM_DIR/nvm.sh" \
    && upgrade_node \
    && nvm cache clear \
    && success 'nvm upgraded' \
    || failed+=('nvm')

  info 'upgrading homebrew formulae...' \
    && brew update \
    && brew upgrade --no-ask \
    && success 'homebrew formulae upgraded' \
    || failed+=('homebrew')

  info 'upgrading ghcup...' \
    && ghcup upgrade \
    && ghcup install ghc recommended \
    && ghcup set ghc recommended \
    && ghcup install cabal recommended \
    && ghcup set cabal recommended \
    && ghcup install stack recommended \
    && ghcup set stack recommended \
    && ghcup gc --unset \
    && success 'ghcup upgraded' \
    || failed+=('ghcup')

  info 'upgrading kmonad...' \
    && cabal update \
    && cabal install --overwrite-policy=always \
      kmonad \
    && sudo install --mode 0755 "${HOME}/.cabal/bin/kmonad" /usr/local/bin/kmonad \
    && sudo systemctl try-restart 'kmonad@*.service' \
    && success 'kmonad upgraded' \
    || failed+=('kmonad')

  info 'upgrading opencode...' \
    && opencode upgrade \
    && success 'opencode upgraded' \
    || failed+=('opencode')

  (( ${#failed[@]} == 0 )) || die "upgrades failed: ${failed[*]}"
  success 'all upgrades complete'
}

main "$@"
